	path = nvim/packer/cmp-nvim-ultisnips
  url = https://github.com/quangnguyen30192/cmp-nvim-ultisnips
  update = merge
[submodule "nvim/packer/guihua.lua"]
	path = nvim/packer/guihua.lua
	url = https://github.com/ray-x/guihua.lua
  update = merge
[submodule "nvim/packer/navigator.lua"]
	path = nvim/packer/navigator.lua
