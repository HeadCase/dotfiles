	path = nvim/packer/lspsaga.nvim
	url = https://github.com/glepnir/lspsaga.nvim
  update = merge
  branch = main
[submodule "nvim/packer/packer/start/nvim-compe"]
	path = nvim/packer/nvim-compe
	url = https://github.com/hrsh7th/nvim-compe
  update = merge
  branch = master
[submodule "nvim/packer/vim-snippets"]
	path = nvim/packer/vim-snippets
	url = https://github.com/honza/vim-snippets
  update = merge
  branch = master
[submodule "nvim/packer/ultisnips"]
	path = nvim/packer/ultisnips
  url = https://github.com/SirVer/ultisnips/
  update = merge
  branch = master
[submodule "tmux/plugins/tmux-net-speed"]
  path = tmux/plugins/tmux-net-speed
  url = https://github.com/tmux-plugins/tmux-net-speed
[submodule "tmux/plugins/tmux-plugin-sysstat"]
  path = tmux/plugins/tmux-plugin-sysstat
  url = https://github.com/samoshkin/tmux-plugin-sysstat
[submodule "tmux/plugins/tmux-prefix-highlight"]
  path = tmux/plugins/tmux-prefix-highlight
  url = https://github.com/tmux-plugins/tmux-prefix-highlight
[submodule "nvim/packer/trouble.nvim"]
	path = nvim/packer/trouble.nvim
	url = https://github.com/folke/trouble.nvim
  update = merge
  branch = main
[submodule "oh-my-zsh"]
	path = oh-my-zsh
	url = https://github.com/ohmyzsh/ohmyzsh
[submodule "zsh/plugins/zsh-autosuggestions"]
	path = zsh/plugins/zsh-autosuggestions
	url = https://github.com/zsh-users/zsh-autosuggestions
