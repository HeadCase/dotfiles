# This file contains profile wide aliases.  This file is referenced by .zshrc
# in the user home directory.

alias nv='nvim'
alias vi='nvim'
alias cat='bat'
alias ls='eza --icons'
alias l='eza -l --icons --color-scale size'
alias v='l'
alias vt='v -T'
alias vv='eza -la --icons --color-scale size'
alias grep='rg'
alias du='dust'
alias find ='fd'
alias ps='procs'
alias top='bottom'
alias cd='z'
alias wtr='curl wttr.in'
alias top=htop
alias j=jobs
alias h=history
alias dirs='dirs -v'
alias pd='pushd'
alias wtr='curl v2n.wttr.in'
alias ql='qlmanage -p'
alias gl='git log --oneline --decorate'
alias gs='git status'
alias gsw='git switch'
alias gd='git diff'
alias gb='git branch'
alias gba='git branch -r | grep -v "\->" | sed "s,\x1B\[[0-9;]*[a-zA-Z],,g" | while read remote; do git branch --track "${remote#origin/}" "$remote"; done'
alias gpl='git pull'
alias gpla='git pull --all'
alias gpu='git push'
alias gc='git commit'
alias jqm="jq 'del(.ecgConfiguration,.imuConfiguration,.sensor.imuConfiguration, .sensor.ecgConfiguration)'"

alias bathelp='bat --plain --language=help'
help() {
    "$@" --help 2>&1 | bathelp
}
