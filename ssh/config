# Need config to automate ssh-agents

Host muir-wall
	AddKeysToAgent yes
	ForwardAgent yes
	IdentityFile ~/.ssh/bastion
	Hostname muir-wall


Host muir-ext
	AddKeysToAgent yes
	ForwardAgent yes
	Hostname muir-wall
	IdentityFile ~/.ssh/bastion
	ProxyCommand ssh -A -p 231 lynn@gheadley.dyndns.org -W %h:%p

Host fourier
 	Hostname bionic-fourier
 	IdentityFile ~/.ssh/bastion

Host fourier-ext
  User gheadley
	AddKeysToAgent yes
	ForwardAgent yes
	Hostname bionic-fourier
	IdentityFile ~/.ssh/bastion
	ProxyCommand ssh -A -p 231 lynn@gheadley.dyndns.org -W %h:%p

Host unifi
 	Hostname xenial-unifi
 	IdentityFile ~/.ssh/bastion

Host unifi-ext
  User gheadley
	AddKeysToAgent yes
	ForwardAgent yes
	Hostname xenial-unifi
	IdentityFile ~/.ssh/bastion
	ProxyCommand ssh -A -p 231 lynn@gheadley.dyndns.org -W %h:%p

Host bastion
	AddKeysToAgent yes
	Hostname bionic-bastion
	User lynn
	IdentityFile ~/.ssh/bastion
	Port 231
	ForwardAgent yes

Host bastion-ext
	AddKeysToAgent yes
	Hostname gheadley.dyndns.org
	User lynn
	IdentityFile ~/.ssh/bastion
	Port 231
	ForwardAgent yes
