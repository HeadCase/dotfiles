# oh-my-zsh setup
ZSH=$HOME/.oh-my-zsh
source $ZSH/oh-my-zsh.sh
source $HOME/.dotfiles/zsh/fast-syntax-highlighting/fast-syntax-highlighting.plugin.zsh

export PYENV_ROOT="$HOME/.pyenv"
PATH="$PATH:$PYENV_ROOT/bin:$HOME/.local:$HOME/.local/bin/kitty:/usr/local/go/bin:$HOME/go/bin/:/usr/local/cuda-11.7/bin"
export PATH

if command -v pyenv 1>/dev/null 2>&1; then
  eval "$(pyenv init -)"
fi
. "$HOME/.cargo/env"



setopt NO_AUTO_PUSHD
setopt NO_CORRECT
plugins=(
  git 
  tmux 
  pyenv 
  zsh-autosuggestions 
  zsh-completions
)

# History and aliases
HISTFILE=$HOME/.cache/zsh_history
source ~/.alias

# Plugins 
eval "$(zoxide init zsh)"
eval "$(starship init zsh)"

# Exports
[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh
export FZF_DEFAULT_COMMAND='rg --files --no-ignore-vcs --hidden'
export PYENV_VIRTUALENV_DISABLE_PROMPT=1
export BAT_THEME="TwoDark"
export MANPATH=/usr/local/share/man:/usr/share/man:$MANPATH
export COLORTERM=truecolor

# Bindings
bindkey "^P" up-line-or-beginning-search
bindkey "^N" down-line-or-beginning-search

alias luamake=/home/gheadley/src/lua-language-server/3rd/luamake/luamake


# click autocompletes
if (( $+commands[pucktools] )); then
  . ~/.pucktools-complete.zsh
fi
if (( $+commands[consumer-db] )); then
  . ~/.consumer-db-complete.zsh
fi


# MaximSDK location
if [ -d "$HOME/MaximSDK" ]; then
  PATH=$PATH:"$HOME/MaximSDK/Tools/GNUTools/10.3/bin":"$HOME/MaximSDK/Tools/xPack/riscv-none-embed-gcc/10.2.0-1.2":"$HOME/MaximSDK/Tools/OpenOCD"
fi
export PATH


# >>> conda initialize >>>
# !! Contents within this block are managed by 'conda init' !!
__conda_setup="$('/home/gheadley/miniconda3/bin/conda' 'shell.zsh' 'hook' 2> /dev/null)"
if [ $? -eq 0 ]; then
    eval "$__conda_setup"
else
    if [ -f "/home/gheadley/miniconda3/etc/profile.d/conda.sh" ]; then
        . "/home/gheadley/miniconda3/etc/profile.d/conda.sh"
    else
        export PATH="/home/gheadley/miniconda3/bin:$PATH"
    fi
fi
unset __conda_setup
# <<< conda initialize <<<

# The following lines were added by compinstall
zstyle :compinstall filename '/home/gheadley/.zshrc'

autoload -Uz compinit
compinit
# End of lines added by compinstall
function zr () { zellij run --name "$*" -- zsh -ic "$*";}
function zrf () { zellij run --name "$*" --floating -- zsh -ic "$*";}
function ze () { zellij edit "$*";}
function zef () { zellij edit --floating "$*";}
