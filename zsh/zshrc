# alacritty day/night colourscheme toggle
function reload_nvim_night {
    for SERVER in $(nvr --serverlist); do
        nvr -cc "source ~/.vim/night.vim" --servername $SERVER &
    done
}

function reload_nvim_day {
    for SERVER in $(nvr --serverlist); do
        nvr -cc "source ~/.vim/day.vim" --servername $SERVER &
    done
}

COLOR_DIR="$HOME/.config/alacritty/colors"
LIGHT_COLOR='material.yaml'
DARK_COLOR='material.yaml'

alias day="alacritty-colorscheme -V -C $COLOR_DIR apply $LIGHT_COLOR && reload_nvim_day"
alias night="alacritty-colorscheme -V -C $COLOR_DIR apply $DARK_COLOR  && reload_nvim_night"
